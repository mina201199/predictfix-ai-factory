# Local Windows setup uses llama.cpp; start.ps1 sets these for its process.
APP_MODE=production
DEMO_MODE=0
# First empty-database startup only: set a unique password with 16+ characters.
# BOOTSTRAP_PASSWORD=
# Production DB defaults to data/factory.db; -Demo uses data/predictfix.db.
LLM_PROVIDER=llamacpp
LLM_URL=http://127.0.0.1:8081
LOCAL_LLM_MODEL=gemma-4-E2B-it-Q8_0
# SQLite is the local default. Docker Compose selects PostgreSQL.
# DATABASE_URL=postgresql+psycopg://predictfix:local-demo-only@127.0.0.1/predictfix
# Optional Ollama alternative (set LLM_PROVIDER=ollama):
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e2b-it-q8_0
# Only OPENAI_* settings below are loaded from .env by the backend.
# Other settings above must be set in the process environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TOTAL_BUDGET_USD=3.00
# Cloud document transmission defaults to blocked; synthetic permits builtin demo sources only.
OPENAI_DOCUMENT_ACCESS=none

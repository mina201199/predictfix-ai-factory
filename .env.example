# Local Windows setup uses llama.cpp; start.ps1 sets these for its process.
LLM_PROVIDER=llamacpp
LLM_URL=http://127.0.0.1:8081
LOCAL_LLM_MODEL=Qwen3-0.6B-Q8_0
# SQLite is the local default. Docker Compose selects PostgreSQL.
# DATABASE_URL=postgresql+psycopg://predictfix:local-demo-only@127.0.0.1/predictfix
# Optional Ollama alternative (set LLM_PROVIDER=ollama):
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:0.6b
# .env is an example only; variables must be set in the process environment.

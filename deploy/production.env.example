# Copy to an ignored .env.production file. Use fresh secrets; never commit it.
APP_DOMAIN=maintenance.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://predictfix:REPLACE_WITH_URL_ENCODED_PASSWORD@db/predictfix
BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_16_PLUS_CHARACTER_PASSWORD
OLLAMA_MODEL=gemma4:e2b-it-q8_0


# Copy to an ignored .env.production file. Use fresh secrets; never commit it.
APP_DOMAIN=maintenance.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://predictfix:REPLACE_WITH_URL_ENCODED_PASSWORD@db/predictfix
BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_16_PLUS_CHARACTER_PASSWORD
OLLAMA_MODEL=gemma4:e2b-it-q8_0
# 工單介接（選填）。留空時介接入口一律回 401，integration-worker 只會閒置輪詢。
# 單行 JSON，整個值用單引號包住；每個 key 的 secret 須另外隨機產生且至少 32 字元，格式見 docs/ticket-integration.md。
# outboundUrl 須是 integration-worker 容器連得到的固定目的地；容器內的 127.0.0.1 指的是容器自己。
# 下列占位 secret 不足 32 字元，照抄也會被拒絕：
# INTEGRATION_SOURCES='{"mes-a":{"keys":{"v1":"REPLACE_WITH_GENERATED_SECRET"},"outboundKeyId":"v1","outboundUrl":"https://mes.example.com/events"}}'
INTEGRATION_SOURCES=
